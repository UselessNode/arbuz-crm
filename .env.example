# Скопируйте в .env и подставьте свои значения

# База данных PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/arbuz_crm"

# --- Аутентификация и файлы ---

# Секрет для подписи JWT (в проде — длинная случайная строка)
JWT_SECRET="change-me"

# Учётная запись администратора (создаётся командой `bun seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Каталог загрузки файлов (по умолчанию ./uploads от корня запуска)
UPLOAD_DIR="./uploads"
