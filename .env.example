# Скопируйте в .env и подставьте свои значения

# База данных PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/arbuz_crm"

# --- Аутентификация и файлы ---

# Секрет для подписи JWT (в проде — длинная случайная строка)
JWT_SECRET="change-me"

# Учётная запись администратора (создаётся командой `bun seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Каталог загрузки файлов (по умолчанию ./uploads от корня запуска)
UPLOAD_DIR="./uploads"

# --- Необязательные параметры (значения по умолчанию подходят для локальной разработки) ---

# Порт backend, по умолчанию 3000
# PORT=3000

# production включает строгие проверки и отключает демо-данные в seed
# NODE_ENV=development

# false — сидировать только админа, статусы и вердикты (без демо-набора)
# SEED_DEMO=true

# Переопределение демо-пользователей (см. apps/backend/seed/data.ts)
# DEMO_EMAIL=demo@arbuz.local
# DEMO_PASSWORD=demo12345
# EXPERT_EMAIL=expert@arbuz.local
# EXPERT_PASSWORD=expert12345
# EXPERT2_EMAIL=expert2@arbuz.local
# EXPERT2_PASSWORD=expert12345
