// C:\project\arbuz-crm\packages\shared\prisma\schema.prisma
generator client {
  provider        = "prisma-client-js"           // "prisma-client" for Prisma v7+
  output          = "../src/generated/prisma" // "prisma-client-js" for Prisma v6 and older
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum RoleType {
  admin
  expert
  applicant
}

/// Тип документа согласия пользователя.
/// terms — пользовательское соглашение; personal_data_consent — согласие на обработку ПДн.
/// Это два независимых события (требование 152-ФЗ).
enum ConsentDocumentType {
  terms
  personal_data_consent
}

/// Тип уведомления (для фильтра в центре уведомлений).
enum NotificationType {
  application_status
  expert_assignment
  account_inactive
  account_created
  publication
  document
  admin_message
}

model review_statuses {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?
  /// Цвет бейджа во фронтенде (neutral/blue/green/yellow/red/purple/gray).
  tone        String    @default("gray") @db.VarChar(20)
  /// Статус, который выставляется новой рецензии.
  is_default  Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  application_reviews application_reviews[]

  @@index([deleted_at], map: "idx_review_statuses_deleted", where: raw("(deleted_at IS NULL)"))
}

enum PdfExportStatus {
  pending
  processing
  done
  error
}

/// Тип PDF-отчёта (совпадает с PdfReportKind из packages/shared/src/constants/pdf-export.ts).
enum PdfReportKind {
  application
  reviews
}

model additional_materials {
  id              Int          @id @default(autoincrement())
  application_id  Int
  file_path       String       @db.VarChar(255)
  file_name       String       @db.VarChar(255)
  file_type       String?      @db.VarChar(50)
  file_bytes_size Decimal?     @db.Decimal(10, 2)
  comment         String?
  uploaded_at     DateTime     @default(now()) @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?    @db.Timestamptz(6)
  applications    applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_additional_materials_application")
  @@index([deleted_at], map: "idx_additional_materials_deleted", where: raw("(deleted_at IS NULL)"))
}

model application_reviews {
  id             Int      @id @default(autoincrement())
  application_id Int
  expert_id      Int
  status_id      Int?
  review_text    String?
  rating         Json?    // Оценка эксперта по критериям в JSON формате: { criterion_id: value }
  total_score    Float?   // Итоговая оценка (сумма с учётом весов)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users        @relation(fields: [expert_id], references: [id], onUpdate: NoAction)
  review_statuses review_statuses? @relation(fields: [status_id], references: [id], onUpdate: NoAction)

  @@unique([application_id, expert_id])
  @@index([application_id], map: "idx_app_reviews_application")
  @@index([deleted_at], map: "idx_app_reviews_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([expert_id], map: "idx_app_reviews_expert")
  @@index([status_id], map: "idx_app_reviews_status")
}

model application_statuses {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(50)
  is_editable  Boolean?       @default(true)
  is_deletable Boolean?       @default(true)
  description  String?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?      @db.Timestamptz(6)
  applications applications[]

  @@index([deleted_at], map: "idx_application_statuses_deleted", where: raw("(deleted_at IS NULL)"))
}

model applications {
  id                        Int                    @id @default(autoincrement())
  owner_id                  Int?
  title                     String                 @db.VarChar(255)
  tender_id                 Int?
  direction_id              Int?
  status_id                 Int                    @default(1)
  idea_description          String
  importance_to_team        String
  project_goal              String
  project_tasks             String
  implementation_experience String?
  results_description       String?
  submitted_at              DateTime?              @db.Timestamptz(6)
  created_at                DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                DateTime?              @db.Timestamptz(6)
  additional_materials      additional_materials[]
  application_reviews       application_reviews[]
  directions                directions?            @relation(fields: [direction_id], references: [id], onUpdate: NoAction)
  users                     users?                 @relation(fields: [owner_id], references: [id], onUpdate: NoAction)
  application_statuses      application_statuses   @relation(fields: [status_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenders                   tenders?               @relation(fields: [tender_id], references: [id], onUpdate: NoAction)
  change_logs               change_logs[]
  project_budget            project_budget[]
  project_plans             project_plans[]
  team_members              team_members[]
  pdf_export_jobs           pdf_export_jobs[]

  @@index([created_at], map: "idx_applications_created")
  @@index([deleted_at], map: "idx_applications_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([direction_id], map: "idx_applications_direction")
  @@index([owner_id], map: "idx_applications_owner")
  @@index([status_id], map: "idx_applications_status")
  @@index([status_id, created_at], map: "idx_applications_status_created")
  @@index([submitted_at], map: "idx_applications_submitted")
  @@index([tender_id], map: "idx_applications_tender")
}

model change_logs {
  id             Int           @id @default(autoincrement())
  application_id Int?
  user_id        Int?
  action         String        @db.VarChar(50)
  old_value      Json?
  new_value      Json?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?     @db.Timestamptz(6)
  applications   applications? @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([application_id], map: "idx_change_logs_application")
  @@index([created_at], map: "idx_change_logs_created")
  @@index([deleted_at], map: "idx_change_logs_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([user_id], map: "idx_change_logs_user")
}

model directions {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  description  String?
  tender_id    Int?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?      @db.Timestamptz(6)
  applications applications[]
  tenders      tenders?       @relation(fields: [tender_id], references: [id], onUpdate: NoAction)

  @@index([deleted_at], map: "idx_directions_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([tender_id], map: "idx_directions_tender")
}

model file_categories {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  files       files[]

  @@index([deleted_at], map: "idx_file_categories_deleted", where: raw("(deleted_at IS NULL)"))
}

model files {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  description     String?
  file_type       String?          @db.VarChar(50)
  category_id     Int?
  path            String?          @db.VarChar(500)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?        @db.Timestamptz(6)
  file_categories file_categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  posts_files     posts_files[]
  pdf_export_jobs pdf_export_jobs[]
  documents       documents[]

  @@index([category_id], map: "idx_files_category")
  @@index([deleted_at], map: "idx_files_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([name], map: "idx_files_name")
}

model project_budget {
  id             Int          @id @default(autoincrement())
  application_id Int
  resource_type  String       @db.VarChar(255)
  unit_cost      Decimal?     @db.Decimal(10, 2)
  quantity       Int?
  own_funds      Decimal?     @db.Decimal(10, 2)
  grant_funds    Decimal?     @db.Decimal(10, 2)
  comment        String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?    @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_project_budget_application")
  @@index([deleted_at], map: "idx_project_budget_deleted", where: raw("(deleted_at IS NULL)"))
}

model project_plans {
  id                Int          @id @default(autoincrement())
  application_id    Int
  task              String
  event_name        String
  event_description String?
  start_date        DateTime?    @db.Date
  end_date          DateTime?    @db.Date
  results           String?
  fixation_form     String?
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?    @db.Timestamptz(6)
  applications      applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_project_plans_application")
  @@index([deleted_at], map: "idx_project_plans_deleted", where: raw("(deleted_at IS NULL)"))
}

model schema_migrations {
  version    String    @id @db.VarChar(255)
  applied_at DateTime? @default(now()) @db.Timestamp(6)
}

model team_members {
  id                 Int          @id @default(autoincrement())
  application_id     Int
  surname            String       @db.VarChar(100)
  name               String       @db.VarChar(100)
  patronymic         String?      @db.VarChar(100)
  tasks_in_project   String?
  contact_info       String?      @db.VarChar(255)
  social_media_links String?
  forum_url          String?      @db.VarChar(255)
  is_responsible     Boolean?
  is_coordinator     Boolean?
  education          String?
  work_experience    String?
  is_adult           Boolean?
  consent_file_path  String       @db.VarChar(500)
  consent_files      consent_files[]
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?    @db.Timestamptz(6)
  applications       applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_team_members_application")
  @@index([deleted_at], map: "idx_team_members_deleted", where: raw("(deleted_at IS NULL)"))
}

model tenders {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  description  String?
  experts_count Int           @default(2)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime?      @db.Timestamptz(6)
  applications applications[]
  directions   directions[]
  evaluation_criteria evaluation_criteria[]

  @@index([deleted_at], map: "idx_tenders_deleted", where: raw("(deleted_at IS NULL)"))
}

model evaluation_criteria {
  id           Int      @id @default(autoincrement())
  tender_id    Int
  name         String   @db.VarChar(255)
  description  String?
  min_value    Float    @default(0)
  max_value    Float    @default(10)
  weight       Float    @default(1)
  config       Json?    // Дополнительная конфигурация в JSON формате
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)
  tenders      tenders  @relation(fields: [tender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tender_id], map: "idx_evaluation_criteria_tender")
  @@index([deleted_at], map: "idx_evaluation_criteria_deleted", where: raw("(deleted_at IS NULL)"))
}

model users {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(255)
  password_hash String         @db.VarChar(255)
  surname       String?        @db.VarChar(100)
  name          String?        @db.VarChar(100)
  patronymic    String?        @db.VarChar(100)
  /// Регион пользователя (справочник regions). Nullable — у старых записей может быть пусто.
  region_id     Int?
  role          RoleType       @default(applicant)
  last_activity DateTime       @default(now()) @db.Timestamptz(6)
  /// Активация учётной записи: null — аккаунт создан, но пользователь ещё не принял ПС/ПДн.
  /// Админы и самозарегистрированные активны сразу; аккаунты от админа — после активации.
  activated_at  DateTime?      @db.Timestamptz(6)
  /// Кто создал аккаунт (админ); null — саморегистрация/seed.
  created_by    Int?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime?      @db.Timestamptz(6)
  applications  applications[]
  change_logs   change_logs[]
  application_reviews application_reviews[]
  posts         posts[]
  consent_documents consent_documents[] @relation("ConsentDocumentAuthor")
  consent_events    consent_events[]    @relation("ConsentEventUser")
  notifications     notifications[]     @relation("NotificationRecipient")
  notifications_sent notifications[]    @relation("NotificationAuthor")
  region        regions?           @relation(fields: [region_id], references: [id], onUpdate: NoAction)
  site_settings_updated site_settings[] @relation("SiteSettingAuthor")

  @@index([deleted_at], map: "idx_users_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([last_activity], map: "idx_users_last_activity")
  @@index([role], map: "idx_users_role")
  @@index([region_id], map: "idx_users_region")
}

/// Справочник регионов (субъекты РФ и прочие). Отдельная таблица — чтобы можно было
/// добавлять/переименовывать регионы без изменения кода (юридическая устойчивость).
model regions {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(200)
  /// Регион по умолчанию (подставляется в формах) — ровно один.
  is_default Boolean  @default(false)
  /// Ручной порядок отображения (меньше — выше); при равенстве — по названию.
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  users      users[]

  @@index([deleted_at], map: "idx_regions_deleted", where: raw("(deleted_at IS NULL)"))
}

model consent_files {
  id             Int          @id @default(autoincrement())
  team_member_id Int
  file_path      String       @db.VarChar(500)
  file_name      String?      @db.VarChar(255)
  file_type      String?      @db.VarChar(50)
  file_size      Int?
  uploaded_at    DateTime     @default(now()) @db.Timestamptz(6)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?    @db.Timestamptz(6)
  team_members   team_members @relation(fields: [team_member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([team_member_id], map: "idx_consent_files_team_member")
  @@index([deleted_at], map: "idx_consent_files_deleted", where: raw("(deleted_at IS NULL)"))
}

/// Долгие уведомления пользователя (центр уведомлений).
model notifications {
  id          Int              @id @default(autoincrement())
  user_id     Int
  type        NotificationType
  title       String           @db.VarChar(255)
  /// Текст (Markdown); фронтенду отдаётся безопасный HTML.
  body        String?          @db.Text
  /// Внутренний маршрут/ссылка для перехода из уведомления.
  link        String?          @db.VarChar(500)
  is_read     Boolean          @default(false)
  read_at     DateTime?        @db.Timestamptz(6)
  /// Ключ идемпотентности (для периодических уведомлений); NULL — обычное разовое.
  dedupe_key  String?          @db.VarChar(200)
  /// Кто отправил (для целевых сообщений админа).
  created_by  Int?
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  user        users            @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author      users?           @relation("NotificationAuthor", fields: [created_by], references: [id], onUpdate: NoAction)

  @@unique([user_id, dedupe_key])
  @@index([user_id, is_read], map: "idx_notifications_user_read")
  @@index([user_id, created_at], map: "idx_notifications_user_created")
  @@index([type], map: "idx_notifications_type")
}

/// Неизменяемые редакции текстов соглашений пользователя.
/// Старые редакции не перезаписываются: новая редакция — новая строка со своим хэшем.
/// Минимальная доказательная цепочка: «кто → что → какую версию → когда → каким действием».
model consent_documents {
  id            Int                 @id @default(autoincrement())
  document_type ConsentDocumentType
  /// Версия редакции (напр. дата). В паре с типом уникальна.
  version       String              @db.VarChar(50)
  /// SHA-256 хэш текста (hex, 64 символа) — фиксирует неизменность редакции.
  hash_sha256   String              @db.Char(64)
  /// Полный текст редакции (Markdown); фронтенду отдаётся безопасный HTML.
  text          String              @db.Text
  published_at  DateTime            @default(now()) @db.Timestamptz(6)
  created_by    Int?
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  author        users?              @relation("ConsentDocumentAuthor", fields: [created_by], references: [id], onUpdate: NoAction)

  @@unique([document_type, version])
  @@index([document_type, published_at], map: "idx_consent_documents_type_published")
}

/// Журнал принятия согласий — доказательная запись. Записи не изменяются:
/// отзыв или новое согласие оформляются отдельным событием.
model consent_events {
  id                String              @id @default(uuid())
  user_id           Int
  document_type     ConsentDocumentType
  document_version  String              @db.VarChar(50)
  document_hash     String              @db.Char(64)
  accepted_at       DateTime            @default(now()) @db.Timestamptz(6)
  /// IP-адрес клиента в момент принятия (IPv4/IPv6, до 45 символов).
  ip_address        String?             @db.VarChar(45)
  /// User-Agent клиента (полезен как доказательство).
  user_agent        String?             @db.Text
  /// Способ подтверждения (напр. "checkbox+submit").
  acceptance_method String              @default("checkbox") @db.VarChar(50)
  user              users               @relation("ConsentEventUser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_consent_events_user")
  @@index([document_type], map: "idx_consent_events_type")
  @@index([accepted_at], map: "idx_consent_events_accepted")
}

// Публичные документы (согласия, положения и прочее), которые администратор
// выкладывает в разделе «Документы» на домашней странице. Файл хранится в `files`.
model documents {
  id                    Int       @id @default(autoincrement())
  title                 String    @db.VarChar(255)
  description           String?
  file_id               Int
  /// Ручной порядок отображения (меньше — выше).
  sort_order            Int       @default(0)
  /// Опубликован ли документ в публичном разделе на главной.
  is_published          Boolean   @default(true)
  /// Назначен шаблоном согласия ПДн: 'minor' (до 14) или 'adult' (с 14); null — обычный документ.
  consent_template_kind String?   @unique @db.VarChar(10)
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime? @db.Timestamptz(6)
  file                  files     @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_published, sort_order], map: "idx_documents_public")
  @@index([deleted_at], map: "idx_documents_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([file_id], map: "idx_documents_file")
}

/// Настраиваемые администратором текстовые блоки сайта (ключ → значение, Markdown).
/// Примеры ключей: 'about' (страница «О проекте»), 'home_contacts' (блок контактов на главной),
/// 'footer' (содержимое подвала). Без версионирования — хранится только текущее значение.
model site_settings {
  key        String   @id @db.VarChar(50)
  /// Текст в Markdown; фронтенду отдаётся безопасный HTML.
  value      String   @db.Text
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  author     users?   @relation("SiteSettingAuthor", fields: [updated_by], references: [id], onUpdate: NoAction)
}

// Настраиваемые администратором подсказки к разделам формы заявки (текст + ссылки на документы).
// Один ряд на раздел (`section_key`); ссылки на документы задаются прямо в тексте URL-адресами.
model application_section_hints {
  id          Int      @id @default(autoincrement())
  section_key String   @unique @db.VarChar(50)
  text        String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

model posts {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(255)
  content      String   @db.Text
  is_published Boolean  @default(false)
  /// Скрывать автора публикации в ленте (для обратной связи от организации).
  hide_author  Boolean  @default(false)
  /// Планируемая дата публикации: до её наступления публикация — «Запланирована»,
  /// после — считается опубликованной (без фонового воркера).
  scheduled_at DateTime? @db.Timestamptz(6)
  /// Дата архивации: публикация скрыта с домашней страницы.
  archived_at  DateTime? @db.Timestamptz(6)
  /// Когда последний раз менялось содержимое (заголовок/текст) — для отметки «Отредактировано».
  edited_at    DateTime? @db.Timestamptz(6)
  /// Закрепление в ленте: закреплённые публикации идут первыми (и на главной, и в списке).
  pinned       Boolean   @default(false)
  /// Ручной порядок отображения внутри группы (меньше — выше); при равенстве — по дате.
  sort_order   Int       @default(0)
  created_by   Int?
  category_id  Int?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  author    users?           @relation(fields: [created_by], references: [id])
  posts_files posts_files[]

  @@index([is_published], map: "idx_posts_published")
  @@index([category_id], map: "idx_posts_category")
  @@index([created_at], map: "idx_posts_created")
  @@index([deleted_at], map: "idx_posts_deleted", where: raw("(deleted_at IS NULL)"))
  @@index([pinned, sort_order], map: "idx_posts_order")
}

// Задачи асинхронной генерации PDF-отчётов.
model pdf_export_jobs {
  id             Int             @id @default(autoincrement())
  /// Что выгружается: отчёт по заявке (application) или по набору экспертиз (reviews).
  kind           PdfReportKind   @default(application)
  /// Отбор экспертиз для kind = reviews: { expert_id } | { status_id } |
  /// { application_id } | { review_ids: number[] }. Для kind = application не используется.
  params         Json?
  /// Подпись отчёта для списка и тостов («Отчёт по эксперту: Иванов И. И.»).
  label          String?         @db.VarChar(255)
  /// Заполняется только для kind = application.
  application_id Int?
  status         PdfExportStatus @default(pending)
  file_id        Int? // файл с готовым PDF (строки из tables files), заполняется после генерации
  error          String?         @db.Text
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  applications   applications?   @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  files          files?          @relation(fields: [file_id], references: [id], onUpdate: NoAction, onDelete: SetNull)

  @@index([application_id], map: "idx_pdf_export_jobs_application")
  @@index([status], map: "idx_pdf_export_jobs_status")
  @@index([file_id], map: "idx_pdf_export_jobs_file")
  @@index([kind, created_at], map: "idx_pdf_export_jobs_kind_created")
}

// Связь поста со вложениями (файлы модуля files).
model posts_files {
  post_id    Int
  file_id    Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  files      files    @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, file_id])
  @@index([file_id], map: "idx_posts_files_file")
}
